{
  "name": "donys-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:docs": "node tools/build-docs-data.mjs",
    "test:docs": "node --test tools/usageMd.test.mjs",
    "test:fn": "node --test tools/functions.test.mjs",
    "test:analytics": "node --test tools/analytics.test.mjs",
    "gtm": "node tools/gtmContainer.mjs",
    "dev": "next dev --turbopack",
    "build": "node tools/build-docs-data.mjs && next build",
    "start": "next start",
    "preview": "npx --yes serve out -l 4173",
    "check": "node tools/deployCheck.mjs",
    "deploy": "npm run build && node tools/stripLegacy.mjs && node tools/deployCheck.mjs --release && npx wrangler pages deploy out --project-name=younameit --branch=main"
  },
  "dependencies": {
    "@rive-app/react-canvas-lite": "^4.36.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.3.8",
    "pretendard": "1.3.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  }
}

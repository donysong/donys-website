{
  "name": "donys-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:docs": "node tools/build-docs-data.mjs",
    "dev": "next dev --turbopack",
    "build": "node tools/build-docs-data.mjs && next build",
    "start": "next start",
    "check": "node tools/deployCheck.mjs",
    "deploy": "npm run build && node tools/stripLegacy.mjs && node tools/deployCheck.mjs && npx wrangler pages deploy out --project-name=younameit --branch=main"
  },
  "dependencies": {
    "@next/third-parties": "^16.3.4",
    "next": "^16.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2"
  }
}

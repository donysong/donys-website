# Cloudflare Pages response headers (the same file serves younameit.works and younameit.pages.dev).
# Hashed build output never changes under its name: cache it for a year. Before this file the default was max-age=14400, must-revalidate,
# and every repeat visit paid a revalidation round trip (about 1 s each through LAX in Korea).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The riso art and the brand stills keep their names when edited rarely: a day, then serve stale while it refreshes.
/riso/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

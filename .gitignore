node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# Secrets. This repo is public, so a committed .env is a published .env.
# The old rule was `.env*.local` only, which left plain `.env` and
# `.env.production` tracked — the two names a deploy is most likely to create.
.env
.env.*
!.env.example

# Local tooling state that can carry project/org ids and tokens.
.vercel
.npmrc

# macOS. public/ 아래 것은 Next 패스스루로 out/ 에 복사돼 웹에 게시된다.
.DS_Store
.gstack/

# Cloudflare Pages Functions 로컬 실행(wrangler pages dev) — 상태·비밀값이 남는다
.wrangler/
.dev.vars

# 원스토어 ONE 모바일고딕 — 재배포 금지 라이선스, 공개 repo 에 올리지 않는다(tools/syncFonts.mjs 가 빌드 전에 복사)
assets/fonts/one-mobile/

